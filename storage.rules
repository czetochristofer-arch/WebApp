rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid));
    }

    match /repairs/{repairId}/{fileName} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /phones/{phoneId}/{fileName} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotky poslané AI asistentovi – každý vidí len svoje.
    match /agent/{uid}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if isMember() && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /business/{fileName} {
      allow read: if isMember();
      allow create, update, delete: if isMember()
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')));
    }
  }
}
