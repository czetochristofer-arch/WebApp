rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isMember() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid));
    }

    match /repairs/{repairId}/{fileName} {
      allow read, delete: if isMember();
      allow create, update: if isMember()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /business/{fileName} {
      allow read: if isMember();
      allow create, update, delete: if isMember()
        && (request.resource == null || (request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')));
    }
  }
}
